{
  "expo": {
    "name": "SignSense AI",
    "slug": "signsense-ai",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#0B0F19"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.signsense.ai"
    },
    "android": {
      "package": "com.signsense.ai",
      "adaptiveIcon": {
        "backgroundColor": "#0B0F19"
      },
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "BLUETOOTH_CONNECT"
      ]
    },
    "plugins": [],
    "extra": {}
  }
}
